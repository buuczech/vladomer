# Per-environment feature flags — NEVER put secrets here (this file is committed).
# This file differs per branch on purpose:
#   dev  = everything on, for testing
#   main = only what is ready for the public
# When merging dev -> main, keep main's version of this file.
#
# BRANCH: main
VITE_MENU_ABOUT=true
VITE_MENU_FAQ=true
VITE_MENU_PROMPTS=true
VITE_MENU_CHARTS=true
# Podpora zůstává skrytá, dokud se nedoladí. Kód tlačítka i obrázky se sem
# mergují, jen se nevykreslí — bez příznaku není položka v menu vůbec.
VITE_MENU_SUPPORT=false
VITE_MENU_IDEAS=true
