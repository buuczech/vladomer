# Auto detect text files and perform LF normalization
* text=auto

# Čteno za běhu skriptem scripts/evaluate.js — musí být stejné na Windows
# i v CI, takže Git je při checkoutu nesmí převádět na CRLF.
# Dvě hvězdičky, ne jedna: „*" v gitattributes nepřekročí lomítko, takže
# jednohvězdičkový vzor míjel podadresáře (chytlo se to na scripts/nastaveni/hudba/).
scripts/nastaveni/** text eol=lf
